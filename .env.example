GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem

# GitHub App Webhook 的 Secret，用来校验 X-Hub-Signature-256。
GITHUB_WEBHOOK_SECRET=
# owner/repo:base，逗号分隔。只接收这些仓库和目标分支的回调。
REVIEW_TARGETS=omiapp/omi-backend:cocome
# 只审这个时刻之后创建的 PR。北京时间 2026-10-28 00:00。
REVIEW_NOT_BEFORE=2026-10-28T00:00:00+08:00
REVIEW_TIMEOUT_SECONDS=300
REVIEW_LISTEN=127.0.0.1:8788
DATABASE_PATH=data/intl-review.sqlite

# 模型：智谱 GLM，Anthropic 兼容端点，直连。key 只放本地 .env，不提交。
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/anthropic
PI_MODEL=glm-5.3
